{
  "name": "vjs-billing-backend",
  "version": "1.0.0",
  "description": "VJS Jewellery Billing System - Express + MongoDB Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "newman run tests/VJS_Billing_API.postman_collection.json --reporters cli,json --reporter-json-export tests/results/newman-results.json",
    "test:report": "newman run tests/VJS_Billing_API.postman_collection.json --reporters cli,htmlextra --reporter-htmlextra-export tests/results/newman-report.html"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cros": "^1.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.4"
  }
}
