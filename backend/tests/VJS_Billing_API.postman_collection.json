            "pm.test('Name is Test Ring', () => pm.expect(body.name).to.eql('Test Ring'));",
            "pm.test('Category is Rings', () => pm.expect(body.category).to.eql('Rings'));",
            "pm.collectionVariables.set('productId', body._id);"
          ]}}]
        },
        {
          "name": "POST /api/products — duplicate HUID (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
