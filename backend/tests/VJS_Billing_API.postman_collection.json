{
  "info": {
    "name": "VJS Billing — Backend API Tests",
    "_postman_id": "vjs-billing-api-tests-v2",
    "description": "Complete API test suite for VJS Jewellery Billing System backend.\nCovers: Auth, Products, Bills, Loans, Schemes, Staff, Settings, Activity Logs.\n\nSetup:\n1. Set `baseUrl` collection variable to http://localhost:5000\n2. Run 'Auth → Login (Admin)' first — it auto-saves the JWT token.\n3. All subsequent requests use {{token}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:5000", "type": "string" },
    { "key": "token",     "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "billId",    "value": "", "type": "string" },
    { "key": "loanId",   "value": "", "type": "string" },
    { "key": "schemeId", "value": "", "type": "string" },
    { "key": "staffId",  "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Backend running', () => pm.expect(pm.response.json().message).to.include('running'));"
          ]}}]
        },
        {
          "name": "Login — missing fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 on missing fields', () => pm.response.to.have.status(400));",
            "pm.test('Has message', () => pm.expect(pm.response.json()).to.have.property('message'));"
          ]}}]
        },
        {
          "name": "Login — invalid credentials (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"System Admin\",\"pin\":\"WRONGPIN\"}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401 on wrong credentials', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Login — Admin (saves token) ✅",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"System Admin\",\"pin\":\"0000\"}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Has token', () => pm.expect(body).to.have.property('token'));",
            "pm.test('Has user', () => pm.expect(body).to.have.property('user'));",
            "pm.test('Role is Admin', () => pm.expect(body.user.role).to.eql('Admin'));",
            "pm.collectionVariables.set('token', body.token);"
          ]}}]
        }
      ]
    },

    {
      "name": "📦 Products",
      "item": [
        {
          "name": "GET /api/products — no auth (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Requires auth — 401', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "GET /api/products (authenticated)",
          "request": {
