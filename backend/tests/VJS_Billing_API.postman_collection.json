            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Duplicate Ring\",\"category\":\"Rings\",\"barcode\":\"TEST-HUID-9999\",\"weight\":3,\"purity\":\"22K\",\"makingCharge\":300,\"stoneCharge\":0,\"goldRate\":7500,\"stock\":1,\"storeId\":\"store-1\",\"metalType\":\"gold\",\"gstPercent\":3}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 on duplicate HUID', () => pm.response.to.have.status(400));",
            "pm.test('Error mentions HUID', () => pm.expect(pm.response.json().message).to.include('HUID'));"
          ]}}]
        },
        {
          "name": "GET /api/products/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","products","{{productId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
